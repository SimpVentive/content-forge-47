# Edge function secrets. Set in production with:
#   supabase secrets set --env-file supabase/functions/.env.production
#
# DO NOT commit a populated copy of this file.
# DO NOT prefix any of these with VITE_ — these are server-only.

# ────────────────────────────────────────────────────────────────────────────
# Auto-injected by Supabase at runtime (no need to set manually):
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY
#   SUPABASE_DB_URL
# ────────────────────────────────────────────────────────────────────────────

# CORS — origin allowed to call functions from the browser. Use the deployed
# frontend's origin; "*" is fine for dev.
ALLOWED_ORIGIN=https://contentforge.app

# ────────────────────────────────────────────────────────────────────────────
# Razorpay
# ────────────────────────────────────────────────────────────────────────────
# Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Dashboard → Settings → Webhooks → (your webhook) → "Webhook secret"
# This is DIFFERENT from RAZORPAY_KEY_SECRET. The webhook function uses it
# to verify X-Razorpay-Signature on incoming webhook calls.
RAZORPAY_WEBHOOK_SECRET=

# ────────────────────────────────────────────────────────────────────────────
# Provider key encryption (provider-config-write / provider-test)
# ────────────────────────────────────────────────────────────────────────────
# Master AES-256-GCM key. Base64-encoded 32 random bytes.
# Generate with: openssl rand -base64 32
# Rotating this invalidates every stored provider API key — re-enter them
# afterwards via the admin UI.
PROVIDER_KEY_ENCRYPTION_SECRET=

# ────────────────────────────────────────────────────────────────────────────
# Resend (send-email)
# ────────────────────────────────────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Verified sender. Format: "Display Name <addr@verified-domain.com>"
EMAIL_FROM=ContentForge <noreply@contentforge.app>

# ────────────────────────────────────────────────────────────────────────────
# Storage (generate-invoice)
# ────────────────────────────────────────────────────────────────────────────
# Bucket holding invoice PDFs. Create as a PRIVATE bucket — the function
# returns time-limited signed URLs.
INVOICE_BUCKET=invoices

# ────────────────────────────────────────────────────────────────────────────
# Image Generation (generate-slide-image)
# ────────────────────────────────────────────────────────────────────────────
# Black Forest Labs Flux 2 API key for AI image generation
# Get from: https://www.blackforestlabs.ai/
BFL_API_KEY=bfl_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
